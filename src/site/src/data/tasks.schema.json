{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quanttide.com/schemas/qtcrowd/tasks.schema.json",
  "title": "量潮众包任务清单数据契约",
  "description": "量潮众包官网（qtcrowd-site）任务数据契约。档案字段（title/business/category/status/background/content/input/reference/deliverables/reward/others）由 scripts/sync-tasks.mjs 从父仓库 data/profile 生成，站点侧字段（name/description/applyGuide）由站点维护；scripts/validate-tasks.mjs 校验本契约并与 data/profile 交叉核对。",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "name",
        "title",
        "description",
        "business",
        "category",
        "status",
        "background",
        "content",
        "input",
        "reference",
        "deliverables",
        "reward",
        "others",
        "applyGuide"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "唯一任务标识（路由参数 / key），与 data/profile/qtcloud 下档案文件名一致（去掉 .md）"
        },
        "title": { "type": "string", "minLength": 1, "description": "任务名（档案 h1）" },
        "description": { "type": "string", "minLength": 1, "description": "目录一句话（站点侧维护）" },
        "business": { "type": "string", "minLength": 1, "description": "业务（档案元数据「业务」）" },
        "category": { "type": "string", "minLength": 1, "description": "类别（档案元数据「类别」）" },
        "status": {
          "type": "string",
          "enum": ["待认领", "进行中", "已关闭"],
          "description": "任务状态（档案元数据「状态」）"
        },
        "background": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "任务背景（档案「任务背景」段落）"
        },
        "content": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "任务内容（档案「任务内容」列表）"
        },
        "input": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "任务输入（档案「任务输入」列表）"
        },
        "reference": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": ["string", "null"] }
            }
          },
          "description": "参考链接（档案「参考链接」列表）"
        },
        "deliverables": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "交付物（档案「交付物」列表）"
        },
        "reward": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "报酬 / 结算（档案「报酬」列表）"
        },
        "others": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "其他说明（档案「其他」列表）"
        },
        "applyGuide": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "如何报名步骤（站点侧维护，含真实接单入口）"
        },
        "deadline": {
          "type": "string",
          "description": "截止日期（可选）"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
